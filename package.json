{
  "name": "nodejs-crud-api",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "start:prod": "npm run build && cross-env NODE_ENV=production node dist/bundle.js",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev ./src/index.ts",
    "start:multi": "cross-env NODE_ENV=development ts-node-dev src/index.ts --multi",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Margaryta-Maletz/nodejs-crud-api.git"
  },
  "keywords": [
    "nodejs",
    "crud-api",
    "Margaryta-Maletz"
  ],
  "author": "Marharyta Malets",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Margaryta-Maletz/nodejs-crud-api/issues"
  },
  "homepage": "https://github.com/Margaryta-Maletz/nodejs-crud-api#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "uuid": "^11.1.0",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  }
}
